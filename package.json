{
  "name": "lens",
  "version": "0.1.0",
  "description": "Read your Instagram export on your own machine. No upload, no account, no server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woosal1337/lens.git"
  },
  "bugs": {
    "url": "https://github.com/woosal1337/lens/issues"
  },
  "author": {
    "name": "Ege Chelebi",
    "url": "https://github.com/woosal1337"
  },
  "homepage": "https://lens.chele.bi",
  "keywords": [
    "instagram",
    "instagram-data",
    "data-export",
    "privacy",
    "local-first",
    "privacy-tools",
    "dashboard",
    "data-visualization",
    "personal-data",
    "no-tracking"
  ],
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1 -p 4173",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run check:comments && npm run check:tokens && npm run check:case && npm run check:csp && npm run check:network && npm run check:layers && npm run check:release && npm run test:guards && npm test",
    "prepare": "husky",
    "check:comments": "node scripts/check-no-comments.mjs",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:network": "node scripts/check-no-network.mjs",
    "check:layers": "node scripts/check-layers.mjs",
    "check:case": "node scripts/check-sentence-case.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "check:build": "node scripts/check-build-policy.mjs",
    "test": "vitest run",
    "test:export": "node scripts/test-export.mjs",
    "postbuild": "node scripts/write-host-headers.mjs",
    "test:guards": "node --test scripts/*.test.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "0.5.0",
    "@astryxdesign/theme-neutral": "0.5.0",
    "@number-flow/react": "^0.5.10",
    "@stylexjs/stylex": "0.19.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.12",
    "@visx/group": "^4.0.0",
    "@visx/responsive": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "fflate": "0.8.3",
    "lucide-react": "1.34.0",
    "motion": "^12.23.12",
    "next": "15.5.25",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@babel/runtime": "^7.29.7",
    "@eslint/js": "^9.34.0",
    "@stylexjs/babel-plugin": "0.19.0",
    "@stylexjs/eslint-plugin": "0.19.0",
    "@stylexjs/postcss-plugin": "0.19.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "postcss": "8.5.28",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "3.2.7"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,md,mjs}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "sharp": "^0.35.0",
    "postcss": "$postcss"
  }
}
